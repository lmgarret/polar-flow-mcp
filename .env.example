# polar-flow-mcp configuration — copy to .env and fill in.
#
# Single-user mode: the server logs into ONE Polar Flow account and acts as
# that user for every MCP request. To serve more than one account, run more
# than one instance (e.g. one container per user).

# ---- Required ----

# Email + password for the Polar Flow account this server acts as.
# Use a TEST account if possible. Password is held in memory only; it is never
# persisted to disk by this server.
POLAR_EMAIL=
POLAR_PASSWORD=

# ---- Optional ----

# Transport: "stdio" (one client, on stdin/stdout) or "http" (default).
# TRANSPORT=http

# Where to persist the long-lived session cookies (FLOW_SESSION + remember-me).
# The file is written chmod 600. Defaults to ./polar-cookies.json next to the
# binary. Use an absolute path in production.
# COOKIE_JAR_PATH=./polar-cookies.json

# HTTP listen address + port (http transport only).
# BIND_ADDRESS=127.0.0.1
# PORT=8080

# Logging.
# LOG_LEVEL=info        # info|debug
# LOG_FILE=             # path; empty = stderr

# ---- Inbound OAuth (Resource Server) ----
#
# Leave OIDC_ISSUER unset for local/trusted-network use (no inbound auth).
# Set it to expose the server publicly (e.g. Claude.ai web/mobile): /mcp then
# requires a Bearer token, validated by RFC 7662 introspection. When set,
# MCP_RESOURCE and the introspection credentials are mandatory.
# Full walkthrough: docs/deployment/exposing-securely.md
#
# OIDC_ISSUER=https://auth.example.com
# MCP_RESOURCE=https://polar.example.com/mcp        # exact public /mcp URL (byte-match)
# OIDC_INTROSPECTION_CLIENT_ID=polar-mcp-rs
# OIDC_INTROSPECTION_CLIENT_SECRET=
#
# Recommended hardening — each enforced only when set (comma-separated, ANDed):
# AUTH_ALLOWED_CLIENT_IDS=polar-mcp-connector       # confused-deputy defence (RFC 8707)
# AUTH_ALLOWED_AUDIENCES=https://polar.example.com/mcp
# AUTH_ALLOWED_SUBJECTS=                            # your IdP sub (Authelia: a UUID)
# AUTH_ALLOWED_GROUPS=                              # alternative to subjects for multi-user IdPs
# AUTH_ALLOWED_ORIGINS=https://claude.ai            # opt-in DNS-rebinding defence
