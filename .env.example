# polar-flow-mcp configuration — copy to .env and fill in.
#
# Single-user mode: the server logs into ONE Polar Flow account and acts as
# that user for every MCP request. To serve more than one account, run more
# than one instance (e.g. one container per user).

# ---- Required ----

# Email + password for the Polar Flow account this server acts as.
# Use a TEST account if possible. Password is held in memory only; it is never
# persisted to disk by this server.
POLAR_EMAIL=
POLAR_PASSWORD=

# ---- Optional ----

# Transport: "stdio" (one client, on stdin/stdout) or "http" (default).
# TRANSPORT=http

# Where to persist the long-lived session cookies (FLOW_SESSION + remember-me).
# The file is written chmod 600. Defaults to ./polar-cookies.json next to the
# binary. Use an absolute path in production.
# COOKIE_JAR_PATH=./polar-cookies.json

# HTTP listen address + port (http transport only).
# BIND_ADDRESS=127.0.0.1
# PORT=8080

# Logging.
# LOG_LEVEL=info        # info|debug
# LOG_FILE=             # path; empty = stderr

# ---- Inbound OAuth (app is its own Authorization Server + DCR) ----
#
# Leave OAUTH_PUBLIC_URL unset for local/trusted-network use (no inbound auth).
# Set it to expose the server publicly (e.g. Claude.ai web/mobile + Claude Code).
# The server then BECOMES its own OAuth 2.1 Authorization Server: clients
# self-register (Dynamic Client Registration — no client to paste), browser
# login on /authorize is delegated to a forward-auth proxy (Authelia), and the
# email allowlist decides who may connect. Access tokens are short-lived EdDSA
# JWTs the server signs and validates itself — no database, no introspection.
# Full walkthrough: docs/src/content/docs/guides/expose-securely.md
#
# OAUTH_PUBLIC_URL=https://polar.example.com   # public origin = OAuth issuer (enables auth)
# OAUTH_ALLOWED_EMAIL=you@example.com          # allowlist of who may connect (comma-separated)
# OAUTH_TRUSTED_PROXIES=172.18.0.0/16          # REQUIRED: networks whose forward-auth identity
#                                              #   headers are trusted (your proxy/container net).
#                                              #   Without it, identity headers are spoofable.
#
# Optional:
# OAUTH_ALLOWED_GROUPS=polar                   # additionally require this forward-auth group
# OAUTH_ALLOWED_ORIGINS=https://claude.ai      # opt-in DNS-rebinding defence on /mcp
# OAUTH_FORWARD_AUTH_EMAIL_HEADER=Remote-Email # header the proxy sets (Authelia default)
# OAUTH_FORWARD_AUTH_GROUPS_HEADER=Remote-Groups
# OAUTH_EXTRA_REDIRECT_URIS=                   # extra exact redirect URIs beyond Claude + loopback
# OAUTH_SIGNING_KEY_PATH=./polar-oauth-key.json # chmod-600 EdDSA key (persist it across restarts)
# OAUTH_ACCESS_TTL_MINUTES=60
# OAUTH_REFRESH_TTL_HOURS=720
